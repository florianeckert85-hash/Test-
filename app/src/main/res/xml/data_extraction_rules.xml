<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Credentials are sensitive: never include this app's data in cloud or device transfers. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="leserkonto_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="leserkonto_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
